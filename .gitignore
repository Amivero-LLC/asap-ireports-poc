# Environment — never commit; the root .env is the source of truth
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Case data — synthetic only in this repo, and never committed by accident
cases/**/documents/
!cases/synthetic/**/documents/.gitkeep
*.pdf
!blueprint*.pdf

# Local model and embedding caches
.cache/
models/

# Build and deploy artifacts
.aws-sam/
*.zip

# OS / editor
.DS_Store
.idea/
.vscode/

# spikes/lambda_fit build artifacts — regenerate with build.py + `sam build --use-container`
spikes/lambda_fit/.stage/
spikes/lambda_fit/.aws-sam/
spikes/lambda_fit/event.json

# spikes/lambda_demo — build artifacts, run output, and a file holding a live proxy key.
# `.env-vars.json` is written by run_case.py on every run and is NOT matched by the `.env.*`
# rule above (that needs a literal dot), so it is named here. Never commit it.
spikes/lambda_demo/.stage/
spikes/lambda_demo/.aws-sam/
spikes/lambda_demo/.env-vars.json
spikes/lambda_demo/out/
