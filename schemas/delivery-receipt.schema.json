{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Amivero-LLC/asap-ireports/schemas/delivery-receipt.schema.json",
  "x-contract-version": "2.0.0",
  "additionalProperties": false,
  "description": "What ASAP said, recorded for reconciliation (blueprint \u00a710.8).",
  "properties": {
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "receipt_id": {
      "pattern": "^rcpt_[A-Za-z0-9][A-Za-z0-9_\\-]{0,62}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "message_id": {
      "pattern": "^msg_[A-Za-z0-9][A-Za-z0-9_\\-]{0,62}$",
      "title": "Message Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run_[A-Za-z0-9][A-Za-z0-9_\\-]{0,62}$",
      "title": "Run Id",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "http_status": {
      "maximum": 599,
      "minimum": 100,
      "title": "Http Status",
      "type": "integer"
    },
    "response_body_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Body Sha256"
    },
    "remote_receipt_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Remote Receipt Id"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "delivered_at": {
      "description": "Timezone-aware UTC timestamp",
      "format": "date-time",
      "title": "Delivered At",
      "type": "string"
    },
    "retriable": {
      "description": "Classification of the outcome, not a raw status echo. A 409 on a duplicate idempotency key is a success for our purposes; a 422 is a dead-letter.",
      "title": "Retriable",
      "type": "boolean"
    }
  },
  "required": [
    "receipt_id",
    "message_id",
    "run_id",
    "idempotency_key",
    "http_status",
    "attempt",
    "delivered_at",
    "retriable"
  ],
  "title": "DeliveryReceipt",
  "type": "object"
}
