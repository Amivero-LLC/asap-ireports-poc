# asap-ireports — local environment
#
#   cp .env.example .env
#
# `.env` is gitignored and must stay that way. Nothing in this file is a secret; everything
# in your `.env` probably is.
#
# ─────────────────────────────────────────────────────────────────────────────
# HOW THIS FILE REACHES A PROCESS (ADR-016)
#
# It does not, automatically. No library in this repo reads `.env` — `GatewayConfig.from_env()`
# and the spike harness read `os.environ` and nothing else, so that local and Lambda behave the
# same way. The file is loaded at entry points, explicitly:
#
#   pytest        the repo-root `conftest.py` loads it (dev only, via python-dotenv)
#   anything else uv run --env-file .env <command>
#
# A variable already set in the real environment always wins over this file.
# ─────────────────────────────────────────────────────────────────────────────
#
# ─────────────────────────────────────────────────────────────────────────────
# ⚠  THE MODEL IDS BELOW ARE PLACEHOLDERS, NOT DEFAULTS.
#
# Q-01 (docs/OPEN-QUESTIONS.md) is the one thing this project refuses to assume: Claude model
# availability in AWS GovCloud, the concrete model and inference-profile IDs, cross-region
# inference rules, and data-routing behaviour are all unvalidated. Confirm every id against the
# target account and region with a real API call before trusting it. A value that works in the
# commercial partition is not evidence about GovCloud.
#
# The gateway has no built-in default model id on purpose — a missing one is a startup error
# naming the variable, not a silent fallback to something plausible.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ Model gateway ═══════════════════════════════════════════════════════════

# litellm | bedrock | stub   (ADR-015)
#   litelm  — default. LiteLLM proxy owns the alias→model mapping; no model id lives here.
#   bedrock — direct AWS. The mapping moves into this file. Use when a proxy is not permitted.
#   stub    — contract tests only. Never in a profile that produces reviewer-visible findings.
IREPORTS_MODEL_ADAPTER=litellm

IREPORTS_MODEL_MAX_TOKENS=16000
IREPORTS_MODEL_TIMEOUT_SECONDS=300
IREPORTS_MODEL_MAX_RETRIES=2

# Reasoning depth per tier: low | medium | high | xhigh | max.
# These replace the removed thinking-token budget; sampling parameters (temperature, top_p,
# top_k) are rejected by current models and are not configurable anywhere in this system.
#
# `fast` is low-effort with thinking still ON, not thinking disabled — disabling thinking can
# cause a tool call to be written as plain text (it silently never runs) and can leak internal
# tags into output. Neither is survivable for a system whose validators depend on structure.
IREPORTS_EFFORT_ORCHESTRATOR=medium
IREPORTS_EFFORT_THINKING=high
IREPORTS_EFFORT_FAST=low


# ═══ Adapter: litellm ════════════════════════════════════════════════════════
# The proxy root. The gateway appends `/anthropic`, LiteLLM's Anthropic-native passthrough, so
# requests travel in the real Messages API format rather than an OpenAI-shaped translation.
IREPORTS_LITELLM_BASE_URL=http://localhost:4000
IREPORTS_LITELLM_API_KEY=

# In LiteLLM's own config, name the models after the three aliases so application code never
# learns an id. That file is where a partition or model-generation change lands:
#
#   model_list:
#     - model_name: ireports-orchestrator
#       litellm_params: { model: bedrock/<CONFIRM VIA Q-01>, aws_region_name: <region> }
#     - model_name: ireports-thinking
#       litellm_params: { model: bedrock/<CONFIRM VIA Q-01>, aws_region_name: <region> }
#     - model_name: ireports-fast
#       litellm_params: { model: bedrock/<CONFIRM VIA Q-01>, aws_region_name: <region> }


# ═══ Adapter: bedrock ════════════════════════════════════════════════════════
# Uses the Anthropic SDK's Bedrock client (Messages API), authenticated by the standard AWS
# credential chain — no proxy, no static key.
IREPORTS_AWS_REGION=
IREPORTS_AWS_PROFILE=

# Escape hatch. The Mantle endpoint is bedrock-mantle.{region}.api.aws; whether that resolves in
# GovCloud is UNVERIFIED and GovCloud endpoints do not generally follow the commercial pattern.
# If it does not exist there, the fallback is a bedrock-runtime adapter — real work, not a flag.
IREPORTS_BEDROCK_BASE_URL=

# PLACEHOLDERS. Must carry the `anthropic.` prefix — the bare first-party id fails on Bedrock,
# and the gateway rejects an id without it at startup. Replace via Q-01, do not copy these.
IREPORTS_BEDROCK_MODEL_ORCHESTRATOR=anthropic.REPLACE-ME-SEE-Q-01
IREPORTS_BEDROCK_MODEL_THINKING=anthropic.REPLACE-ME-SEE-Q-01
IREPORTS_BEDROCK_MODEL_FAST=anthropic.REPLACE-ME-SEE-Q-01


# ═══ Live model smoke check ══════════════════════════════════════════════════
# Opt-in, off by default, never in CI. Set to 1 and run:
#
#   IREPORTS_LIVE_SMOKE=1 uv run pytest tests/live -v -s
#
# Calls each of the three aliases through the configured adapter and prints a compatibility
# matrix (resolved model, token usage, stop reason). Costs money and needs network egress.
# A commercial-partition result is not evidence about GovCloud — see Q-01.
IREPORTS_LIVE_SMOKE=

# ═══ Orchestration spike (Milestone 1c) ══════════════════════════════════════
# docker compose -f infrastructure/docker/compose.yaml up -d
IREPORTS_SPIKE_DSN=postgresql://ireports:ireports_local_only@localhost:5436/ireports_spike


# ═══ Data ════════════════════════════════════════════════════════════════════
# Synthetic only, always. No real case data in this repo — not in fixtures, not in tests, not in
# examples. Production case files may contain PII, SPII, personnel-security information, and CUI.
